RewriteEngine On
RewriteBase /
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# Always revalidate the HTML shell so a deploy shows up immediately.
# Hashed files in assets/ keep their normal caching.
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>
